@page "/text-merger"
@using TextHub.Components.Forms
@using System.Text

<SimpleToolLayout 
    PageTitle="Text Merger"
    ToolName="Text Merger"
    Description="Merge multiple lines of text into a single line with a delimiter"
    ConvertButtonText="Merge Lines"
    UseCaseDescription="Perfect for combining lists into comma-separated strings"
    CategoryName="Text Utility Tools"
    Route="/text-merger"
    ConvertFunction="MergeLines">
    
    <IconSvg>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-combine w-6 h-6 sm:w-8 sm:h-8 text-primary">
            <rect width="8" height="8" x="2" y="2" rx="2"></rect>
            <path d="M14 2c1.1 0 2 .9 2 2v4c0 1.1-.9 2-2 2"></path>
            <path d="M20 2c1.1 0 2 .9 2 2v4c0 1.1-.9 2-2 2"></path>
            <path d="M10 18H5c-1.7 0-3-1.3-3-3v-1"></path>
            <polyline points="7 21 10 18 7 15"></polyline>
            <rect width="8" height="8" x="14" y="14" rx="2"></rect>
        </svg>
    </IconSvg>

    <OptionsContent>
        <div class="grid grid-cols-1 gap-4 max-w-sm">
            <div>
                <label class="block text-xs sm:text-sm font-medium mb-1">Delimiter</label>
                <select @bind="_delimiterType" class="w-full bg-background border border-input rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary">
                    <option value="comma">Comma (,)</option>
                    <option value="comma-space">Comma and Space (, )</option>
                    <option value="space">Space ( )</option>
                    <option value="semicolon">Semicolon (;)</option>
                    <option value="pipe">Pipe (|)</option>
                    <option value="custom">Custom</option>
                </select>
            </div>
            
            @if (_delimiterType == "custom")
            {
                <div>
                    <label class="block text-xs sm:text-sm font-medium mb-1">Custom Delimiter</label>
                    <input type="text" @bind="_customDelimiter" class="w-full bg-background border border-input rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
                </div>
            }
        </div>
    </OptionsContent>
</SimpleToolLayout>

@code {
    private string _delimiterType = "comma-space";
    private string _customDelimiter = "-";

    private string MergeLines(string input)
    {
        if (string.IsNullOrEmpty(input)) return string.Empty;

        var delimiter = _delimiterType switch
        {
            "comma" => ",",
            "comma-space" => ", ",
            "space" => " ",
            "semicolon" => ";",
            "pipe" => "|",
            "custom" => _customDelimiter,
            _ => ", "
        };

        var lines = input.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries)
                         .Select(l => l.Trim());

        return string.Join(delimiter, lines);
    }
}
