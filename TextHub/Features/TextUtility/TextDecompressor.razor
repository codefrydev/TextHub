@page "/text-decompressor"
@using TextHub.Components.Forms
@using System.IO.Compression
@using System.Text
@using System.IO

<SimpleToolLayout 
    PageTitle="Text Decompressor"
    ToolName="Text Decompressor"
    Description="Decompress a Base64 encoded GZip string back to text"
    ConvertButtonText="Decompress Text"
    UseCaseDescription="Perfect for restoring text that was compressed with our Text Compressor"
    CategoryName="Text Utility Tools"
    Route="/text-decompressor"
    ConvertFunction="Decompress">
    
    <IconSvg>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-box w-6 h-6 sm:w-8 sm:h-8 text-primary">
            <path d="M14.5 22H18a2 2 0 0 0 2-2V7.5L14.5 2H6a2 2 0 0 0-2 2v4"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <path d="M2.97 13.12c-.6.36-.97 1.02-.97 1.74v3.28c0 .72.37 1.38.97 1.74l3 1.83c.63.39 1.43.39 2.06 0l3-1.83c.6-.36.97-1.02.97-1.74v-3.28c0-.72-.37-1.38-.97-1.74l-3-1.83a1.97 1.97 0 0 0-2.06 0l-3 1.83Z"></path>
            <path d="m7 17-4.74-2.85"></path>
            <path d="m7 17 4.74-2.85"></path>
            <path d="M7 17v5"></path>
        </svg>
    </IconSvg>
</SimpleToolLayout>

@code {
    private string Decompress(string input)
    {
        if (string.IsNullOrEmpty(input)) return string.Empty;

        try
        {
            byte[] bytes = Convert.FromBase64String(input.Trim());
            using (var msi = new MemoryStream(bytes))
            using (var mso = new MemoryStream())
            {
                using (var gs = new GZipStream(msi, CompressionMode.Decompress))
                {
                    gs.CopyTo(mso);
                }
                return Encoding.UTF8.GetString(mso.ToArray());
            }
        }
        catch (FormatException)
        {
            return "Invalid Base64 format. Ensure you pasted the exact compressed text.";
        }
        catch (InvalidDataException)
        {
            return "Invalid compressed data. Ensure you pasted text compressed by this tool.";
        }
        catch (Exception ex)
        {
            return $"Decompression error: {ex.Message}";
        }
    }
}
