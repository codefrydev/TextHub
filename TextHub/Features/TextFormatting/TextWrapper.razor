@page "/text-wrapper"
@using TextHub.Components.Forms
@using System.Text

<TextFormattingLayout 
    PageTitle="Text Wrapper"
    ToolName="Text Wrapper"
    Description="Wrap text to a specific line length"
    ConvertButtonText="Wrap Text"
    Route="/text-wrapper"
    @bind-Output="_outputText"
    OnConvert="ProcessText">
    
    <IconSvg>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-wrap-text w-6 h-6 sm:w-8 sm:h-8">
            <line x1="3" x2="21" y1="6" y2="6"></line>
            <path d="M3 12h15a3 3 0 1 1 0 6h-4"></path>
            <polyline points="16 16 14 18 16 20"></polyline>
            <line x1="3" x2="10" y1="18" y2="18"></line>
        </svg>
    </IconSvg>

    <OptionsContent>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label class="block text-xs sm:text-sm font-medium mb-1">Wrap Width (characters)</label>
                <input type="number" @bind="_wrapWidth" min="10" max="200" class="w-full bg-background border border-input rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
            </div>
        </div>
    </OptionsContent>
</TextFormattingLayout>

@code {
    private string _outputText = string.Empty;
    private int _wrapWidth = 80;

    private void ProcessText(string input)
    {
        if (string.IsNullOrEmpty(input))
        {
            _outputText = string.Empty;
            return;
        }

        var lines = input.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None);
        var sb = new StringBuilder();

        foreach (var line in lines)
        {
            var words = line.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
            if (words.Length == 0)
            {
                sb.AppendLine();
                continue;
            }
            
            int currentLength = 0;
            for (int i = 0; i < words.Length; i++)
            {
                var word = words[i];
                if (currentLength + word.Length + (currentLength > 0 ? 1 : 0) > _wrapWidth)
                {
                    sb.AppendLine();
                    sb.Append(word);
                    currentLength = word.Length;
                }
                else
                {
                    if (currentLength > 0)
                    {
                        sb.Append(" ");
                        currentLength++;
                    }
                    sb.Append(word);
                    currentLength += word.Length;
                }
            }
            sb.AppendLine();
        }

        if (sb.Length >= Environment.NewLine.Length)
        {
            sb.Length -= Environment.NewLine.Length;
        }
        
        _outputText = sb.ToString();
    }
}
