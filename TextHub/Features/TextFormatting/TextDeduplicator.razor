@page "/text-deduplicator"
@using TextHub.Components.Forms
@using System.Text
@using System.Collections.Generic

<TextFormattingLayout 
    PageTitle="Text Deduplicator"
    ToolName="Text Deduplicator"
    Description="Remove duplicate lines from text"
    ConvertButtonText="Remove Duplicates"
    Route="/text-deduplicator"
    @bind-Output="_outputText"
    OnConvert="ProcessText">
    
    <IconSvg>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy-x w-6 h-6 sm:w-8 sm:h-8">
            <line x1="15" y1="15" x2="9" y2="9"></line>
            <line x1="9" y1="15" x2="15" y2="9"></line>
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
        </svg>
    </IconSvg>

    <OptionsContent>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <label class="flex items-center gap-2 cursor-pointer mt-6">
                <input type="checkbox" @bind="_ignoreCase" class="w-4 h-4 text-primary rounded focus:ring-primary">
                <span class="text-xs sm:text-sm">Ignore Case</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer mt-6">
                <input type="checkbox" @bind="_trimWhitespace" class="w-4 h-4 text-primary rounded focus:ring-primary">
                <span class="text-xs sm:text-sm">Trim Whitespace Before Comparing</span>
            </label>
        </div>
    </OptionsContent>
</TextFormattingLayout>

@code {
    private string _outputText = string.Empty;
    private bool _ignoreCase = false;
    private bool _trimWhitespace = false;

    private void ProcessText(string input)
    {
        if (string.IsNullOrEmpty(input))
        {
            _outputText = string.Empty;
            return;
        }

        var lines = input.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None);
        var seen = new HashSet<string>(_ignoreCase ? StringComparer.OrdinalIgnoreCase : StringComparer.Ordinal);
        var sb = new StringBuilder();

        foreach (var line in lines)
        {
            var lineToCompare = _trimWhitespace ? line.Trim() : line;
            if (seen.Add(lineToCompare))
            {
                sb.AppendLine(line); // Preserve original line for output
            }
        }

        if (sb.Length >= Environment.NewLine.Length)
        {
            sb.Length -= Environment.NewLine.Length;
        }
        
        _outputText = sb.ToString();
    }
}
