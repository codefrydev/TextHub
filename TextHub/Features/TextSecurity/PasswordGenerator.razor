@page "/password-generator"
@using TextHub.Services.Data
@using TextHub.Components.Shared
@using System.Security.Cryptography
@using System.Text
@inject JsonLdService JsonLdService
@inject ToolDataService ToolDataService
@inject MetaTagsService MetaTagsService
@inject IJSRuntime JSRuntime

<PageTitle>Password Generator - Text Hub</PageTitle>

<DynamicMetaTags MetaTags="@_metaTags" />
<DynamicJsonLd JsonLdContent="@_jsonLdContent" Id="passwordgenerator-jsonld" />

<main class="flex-1">
    <div class="container mx-auto px-4 py-8 md:py-12 animate-fade-in">
        <div class="max-w-4xl mx-auto">
            <div class="text-center mb-8 md:mb-10">
                <div class="inline-flex items-center justify-center p-2.5 sm:p-3 bg-primary/10 rounded-lg mb-3 md:mb-4 text-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-key w-6 h-6 sm:w-8 sm:h-8"><path d="m15.5 7.5 2.3 2.3a1 1 0 0 0 1.4 0l2.1-2.1a1 1 0 0 0 0-1.4L19 4"></path><path d="m21 2-9.6 9.6"></path><circle cx="7.5" cy="15.5" r="5.5"></circle></svg>
                </div>
                <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-3 md:mb-4">
                    <span class="text-gradient">Password Generator</span>
                </h1>
                <p class="text-base sm:text-lg text-muted-foreground px-4">Generate strong, secure passwords</p>
            </div>
            
            <div class="grid gap-4 md:gap-6 max-w-2xl mx-auto">
                
                <div class="mb-4 md:mb-6 p-4 md:p-6 bg-muted/30 rounded-lg border border-border animate-fade-in" style="animation-delay: 100ms;">
                    <h3 class="font-semibold mb-4 text-sm md:text-base">Password Options</h3>
                    <div class="grid gap-4">
                        <div>
                            <div class="flex justify-between mb-2">
                                <label class="text-sm font-medium">Password Length</label>
                                <span class="text-sm text-primary font-bold">@_length</span>
                            </div>
                            <input type="range" min="4" max="128" @bind="_length" @bind:event="oninput" class="w-full accent-primary" />
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-2">
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="checkbox" @bind="_useUppercase" class="w-4 h-4 text-primary rounded focus:ring-primary">
                                <span class="text-sm">Uppercase (A-Z)</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="checkbox" @bind="_useLowercase" class="w-4 h-4 text-primary rounded focus:ring-primary">
                                <span class="text-sm">Lowercase (a-z)</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="checkbox" @bind="_useNumbers" class="w-4 h-4 text-primary rounded focus:ring-primary">
                                <span class="text-sm">Numbers (0-9)</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="checkbox" @bind="_useSymbols" class="w-4 h-4 text-primary rounded focus:ring-primary">
                                <span class="text-sm">Symbols (!@@#$%)</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center animate-fade-in" style="animation-delay: 200ms;">
                    <button @onclick="GeneratePassword" class="btn-primary w-full sm:w-auto text-sm sm:text-base py-3">Generate Password</button>
                </div>
                
                @if (!string.IsNullOrEmpty(_outputText))
                {
                    <div class="animate-fade-in mt-4" style="animation-delay: 300ms;">
                        <label class="block text-sm font-medium mb-2">Generated Password</label>
                        <div class="relative">
                            <input type="text"
                                @bind="_outputText"
                                class="w-full bg-muted border border-input rounded-md px-4 py-4 text-lg font-mono text-center tracking-wider text-primary"
                                readonly />
                            <button @onclick="CopyResult" 
                                    class="absolute top-1/2 -translate-y-1/2 right-2 p-2 bg-primary/10 hover:bg-primary/20 rounded-md transition-colors">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy">
                                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
                                </svg>
                            </button>
                        </div>
                    </div>
                }
            </div>
            
            <div class="mt-8 md:mt-12 p-4 md:p-6 bg-muted/30 rounded-lg animate-fade-in" style="animation-delay: 300ms;">
                <h2 class="text-lg md:text-xl font-semibold mb-2 md:mb-3">How it works</h2>
                <ul class="space-y-1.5 md:space-y-2 text-sm md:text-base text-muted-foreground">
                    <li>• Uses cryptographically secure random number generation (RNGCryptoServiceProvider equivalent)</li>
                    <li>• Passwords are generated completely in your browser and never sent to a server</li>
                    <li>• Combine different character sets for stronger security</li>
                </ul>
            </div>
        </div>
    </div>
</main>

@code {
    private string _jsonLdContent = string.Empty;
    private MetaTagsData? _metaTags;
    private string _outputText = string.Empty;

    private int _length = 16;
    private bool _useUppercase = true;
    private bool _useLowercase = true;
    private bool _useNumbers = true;
    private bool _useSymbols = true;

    protected override void OnInitialized()
    {
        var tool = ToolDataService.GetAllTools().FirstOrDefault(t => t.Href == "/password-generator");
        if (tool != null)
        {
            _jsonLdContent = JsonLdService.GenerateToolPageJsonLd(tool, "Text Security Tools");
            _metaTags = MetaTagsService.GetToolPageMetaTags(tool, "Text Security Tools");
        }
        GeneratePassword();
    }

    private void GeneratePassword()
    {
        const string lowercase = "abcdefghijklmnopqrstuvwxyz";
        const string uppercase = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        const string numbers = "0123456789";
        const string symbols = "!@#$%^&*()_+-=[]{}|;:,.<>?";

        var charSet = new StringBuilder();
        if (_useLowercase) charSet.Append(lowercase);
        if (_useUppercase) charSet.Append(uppercase);
        if (_useNumbers) charSet.Append(numbers);
        if (_useSymbols) charSet.Append(symbols);

        if (charSet.Length == 0)
        {
            _outputText = "Please select at least one character set.";
            return;
        }

        var charSetString = charSet.ToString();
        var password = new char[_length];
        var randomBytes = new byte[_length * 4];

        using (var rng = RandomNumberGenerator.Create())
        {
            rng.GetBytes(randomBytes);
        }

        for (int i = 0; i < _length; i++)
        {
            uint randomVal = BitConverter.ToUInt32(randomBytes, i * 4);
            password[i] = charSetString[(int)(randomVal % (uint)charSetString.Length)];
        }

        _outputText = new string(password);
    }

    private async Task CopyResult()
    {
        if (!string.IsNullOrEmpty(_outputText) && !_outputText.StartsWith("Please"))
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _outputText);
        }
    }
}
