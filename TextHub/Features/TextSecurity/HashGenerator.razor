@page "/hash-generator"
@using TextHub.Components.Forms
@using System.Security.Cryptography
@using System.Text

<SimpleToolLayout 
    PageTitle="Hash Generator"
    ToolName="Hash Generator"
    Description="Generate cryptographic hashes from text"
    ConvertButtonText="Generate Hash"
    UseCaseDescription="Perfect for verifying data integrity and securely storing passwords"
    CategoryName="Text Security Tools"
    Route="/hash-generator"
    ConvertFunction="GenerateHash">
    
    <IconSvg>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-fingerprint w-6 h-6 sm:w-8 sm:h-8 text-primary">
            <path d="M2 12C2 6.5 6.5 2 12 2a10 10 0 0 1 8 4"></path>
            <path d="M5 19.5C5.5 18 6 15 6 12c0-3.6 2.4-6.5 6-6.5s6 2.9 6 6.5c0 3-.5 6-1 7.5"></path>
            <path d="M8 21.5c1-1 1-3 1-5.5 0-2.5 1.5-4.5 3-4.5s3 2 3 4.5c0 2.5 0 4.5 1 5.5"></path>
            <path d="M12 22v-3.5"></path>
        </svg>
    </IconSvg>

    <OptionsContent>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label class="block text-xs sm:text-sm font-medium mb-1">Hash Algorithm</label>
                <select @bind="_algorithm" class="w-full bg-background border border-input rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary">
                    <option value="MD5">MD5 (Insecure)</option>
                    <option value="SHA1">SHA-1 (Insecure)</option>
                    <option value="SHA256">SHA-256 (Secure)</option>
                    <option value="SHA512">SHA-512 (Secure)</option>
                </select>
            </div>
            <div>
                <label class="block text-xs sm:text-sm font-medium mb-1">Output Format</label>
                <select @bind="_format" class="w-full bg-background border border-input rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary">
                    <option value="Hex">Hexadecimal</option>
                    <option value="Base64">Base64</option>
                </select>
            </div>
        </div>
    </OptionsContent>
</SimpleToolLayout>

@code {
    private string _algorithm = "SHA256";
    private string _format = "Hex";

    private string GenerateHash(string input)
    {
        if (string.IsNullOrEmpty(input)) return string.Empty;

        try
        {
            byte[] bytes = Encoding.UTF8.GetBytes(input);
            byte[] hashBytes;

            using (var hashAlgorithm = CreateAlgorithm())
            {
                if (hashAlgorithm == null) return "Algorithm not supported.";
                hashBytes = hashAlgorithm.ComputeHash(bytes);
            }

            if (_format == "Hex")
            {
                return Convert.ToHexString(hashBytes).ToLowerInvariant();
            }
            else
            {
                return Convert.ToBase64String(hashBytes);
            }
        }
        catch (Exception ex)
        {
            return $"Error: {ex.Message}";
        }
    }

    private HashAlgorithm? CreateAlgorithm()
    {
        return _algorithm switch
        {
            "MD5" => MD5.Create(),
            "SHA1" => SHA1.Create(),
            "SHA256" => SHA256.Create(),
            "SHA512" => SHA512.Create(),
            _ => null
        };
    }
}
