@page "/url-encoder"
@using TextHub.Components.Forms
@using System.Net

<SimpleToolLayout 
    PageTitle="URL Encoder"
    ToolName="URL Encoder"
    Description="Encode text for use in URLs"
    ConvertButtonText="Encode to URL"
    UseCaseDescription="Perfect for escaping characters to safely pass data in query strings"
    CategoryName="Text Conversion Tools"
    Route="/url-encoder"
    ConvertFunction="Encode">
    
    <IconSvg>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link w-6 h-6 sm:w-8 sm:h-8 text-primary">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
        </svg>
    </IconSvg>
</SimpleToolLayout>

@code {
    private string Encode(string input)
    {
        if (string.IsNullOrEmpty(input)) return string.Empty;
        return Uri.EscapeDataString(input);
    }
}
