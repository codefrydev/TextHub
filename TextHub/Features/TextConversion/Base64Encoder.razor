@page "/base64-encoder"
@using TextHub.Components.Forms
@using System.Text

<SimpleToolLayout 
    PageTitle="Base64 Encoder"
    ToolName="Base64 Encoder"
    Description="Encode text to Base64 format"
    ConvertButtonText="Encode to Base64"
    UseCaseDescription="Perfect for encoding data for transmission over network protocols"
    CategoryName="Text Conversion Tools"
    Route="/base64-encoder"
    ConvertFunction="Encode">
    
    <IconSvg>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock w-6 h-6 sm:w-8 sm:h-8 text-primary">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
            <circle cx="12" cy="16" r="1"></circle>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
    </IconSvg>
</SimpleToolLayout>

@code {
    private string Encode(string input)
    {
        if (string.IsNullOrEmpty(input)) return string.Empty;
        var bytes = Encoding.UTF8.GetBytes(input);
        return Convert.ToBase64String(bytes);
    }
}
