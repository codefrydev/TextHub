@page "/html-decoder"
@using TextHub.Components.Forms
@using System.Net

<SimpleToolLayout 
    PageTitle="HTML Decoder"
    ToolName="HTML Decoder"
    Description="Decode HTML entities to text"
    ConvertButtonText="Decode HTML"
    UseCaseDescription="Perfect for rendering escaped HTML content back to regular characters"
    CategoryName="Text Conversion Tools"
    Route="/html-decoder"
    ConvertFunction="Decode">
    
    <IconSvg>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-code w-6 h-6 sm:w-8 sm:h-8 text-primary">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path>
            <path d="M14 2v6h6"></path>
            <path d="M16 13H8"></path>
            <path d="M16 17H8"></path>
            <path d="M10 9H8"></path>
        </svg>
    </IconSvg>
</SimpleToolLayout>

@code {
    private string Decode(string input)
    {
        if (string.IsNullOrEmpty(input)) return string.Empty;
        return WebUtility.HtmlDecode(input);
    }
}
