@page "/base64-decoder"
@using TextHub.Components.Forms
@using System.Text

<SimpleToolLayout 
    PageTitle="Base64 Decoder"
    ToolName="Base64 Decoder"
    Description="Decode Base64 text to original format"
    ConvertButtonText="Decode Base64"
    UseCaseDescription="Perfect for decoding data received over network protocols"
    CategoryName="Text Conversion Tools"
    Route="/base64-decoder"
    ConvertFunction="Decode">
    
    <IconSvg>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-unlock w-6 h-6 sm:w-8 sm:h-8 text-primary">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
        </svg>
    </IconSvg>
</SimpleToolLayout>

@code {
    private string Decode(string input)
    {
        if (string.IsNullOrEmpty(input)) return string.Empty;
        try 
        {
            var bytes = Convert.FromBase64String(input.Trim());
            return Encoding.UTF8.GetString(bytes);
        }
        catch (FormatException)
        {
            return "Invalid Base64 string.";
        }
    }
}
